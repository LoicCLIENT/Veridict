{
  "name": "veridict",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd apps/api && uvicorn main:app --reload --port 8000",
    "dev:web": "pnpm --filter @veridict/web dev",
    "build": "pnpm --filter @veridict/web build",
    "typecheck": "pnpm --filter @veridict/web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "packageManager": "pnpm@9.0.0"
}
